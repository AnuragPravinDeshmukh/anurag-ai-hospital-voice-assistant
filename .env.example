# =============================================================================
# ANURAG AI HOSPITAL - MULTILINGUAL AI VOICE ASSISTANT
# Environment Configuration Template
# Developer: Anurag Deshmukh
# NOTE: Store this file as .env (never commit .env to public repositories)
# =============================================================================

# =============================================================================
# 1. SARVAM AI CONFIGURATION (Speech-to-Text, Voice Generation, Multilingual LLM)
# Sign up and generate key at: https://dashboard.sarvam.ai/
# =============================================================================
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_API_URL=https://api.sarvam.ai
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_TTS_VOICE=anushka

# =============================================================================
# 2. GOOGLE GEMINI FILE SEARCH (RAG - Knowledge Base Document Retrieval)
# Generate Gemini API key at: https://aistudio.google.com/
# =============================================================================
GOOGLE_API_KEY=your_google_gemini_api_key_here
FILE_SEARCH_STORE_NAME=anurag-hospital-knowledge
FILE_SEARCH_MODEL=gemini-2.5-flash
FILE_SEARCH_ENABLED=true

# =============================================================================
# 3. TWILIO CONFIGURATION (Telephony & Real-time Media Streams)
# Obtain credentials from: https://console.twilio.com/
# =============================================================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
PERSONAL_PHONE=+919876543210

# =============================================================================
# 4. PUBLIC WEBHOOK URL (ngrok for Local Development)
# Start tunnel with: ngrok http 7000
# Update with the generated HTTPS URL:
# =============================================================================
NGROK_URL=https://your-subdomain.ngrok-free.app

# =============================================================================
# 5. MONGODB CONFIGURATION (Call Transcripts & Scheduled Reminder Persistence)
# Local or Atlas connection string:
# =============================================================================
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=anurag_hospital_calls

# =============================================================================
# 6. GOOGLE SHEETS INTEGRATION (Appointment Recording Webhook)
# Google Apps Script Webhook URL:
# =============================================================================
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/your_script_id/exec

# =============================================================================
# 7. HOSPITAL CUSTOMIZATION (Demo Defaults)
# =============================================================================
HOSPITAL_NAME=Anurag AI Hospital
HOSPITAL_ADDRESS=123 Healthcare Boulevard, Tech City, Anna Nagar, Chennai, Tamil Nadu - 600040 (Demo Facility)
HOSPITAL_PHONE=044-2626-XXXX (Demo Helpline)
HOSPITAL_TIMINGS=Monday to Saturday, 9:00 AM to 9:00 PM (Closed on Sundays)
DEFAULT_LANGUAGE=ta-IN

# =============================================================================
# 8. OPTIONAL FAST LLM ALTERNATIVE (Groq)
# =============================================================================
GROQ_API_KEY=your_groq_api_key_optional
